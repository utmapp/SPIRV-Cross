#version 450
layout(local_size_x = 1) in;

struct Record
{
    uint a;
    uint b;
    uint c;
    uint d;
};

layout(std430, binding = 0) readonly buffer ReadSSBO
{
    Record records[];
};

layout(std430, binding = 1) writeonly buffer WriteSSBO
{
    Record result;
};

void main()
{
    result = records[gl_GlobalInvocationID.x];
}
